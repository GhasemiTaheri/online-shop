# Copy this file to .env and replace the values for your environment.
# Do not commit .env; it may contain credentials.

APP_NAME=online-shop
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# The local MongoDB instance must be configured as a replica set for transactions.
# Replace `replace-me` with your local MongoDB password or use an appropriate URI.
MONGODB_URI=mongodb://root:replace-me@localhost:27017/?authSource=admin&replicaSet=rs0
MONGODB_CATALOG_DATABASE=online_shop_catalog
MONGODB_ORDERING_DATABASE=online_shop_ordering
MONGODB_INVENTORY_DATABASE=online_shop_inventory
MONGODB_PAYMENT_DATABASE=online_shop_payment
MONGODB_FULFILLMENT_DATABASE=online_shop_fulfillment
